import _file_.cormas._

val doesPopulationGrow = Val[Boolean]
val reproductionRate = Val[Double]
val mySeed = Val[Int]

val conflictsAverage = Val[Double]
val cattleSize = Val[Double]
val globalFertility = Val[Double]

val runCormas = CormasTask(
  image = "oleks42/cormas-openmole:latest",
  modelFile = workDirectory / "AgriHerders.zip",
  initSelector = "initWithoutAgreement",
  stepSelector = "stepSemester",
  maxSteps = 60,
  stopCondition = "",
  seed = mySeed,
  parameters = Seq(
    doesPopulationGrow -> "doesPopulationGrow",
    reproductionRate -> "AHCattleBatch.reproductionRate_good"
  ),
  probes = Seq(
    conflictsAverage -> "conflictsAverage",
    cattleSize -> "cattleSize",
    globalFertility -> "globalFertility"
  )
)

val exploration =
  DirectSampling(
    evaluation = runCormas,
    sampling =
      (mySeed in (1 to 10)) x
      (doesPopulationGrow in Seq(true, false)) x
      (reproductionRate in Seq(0.15, 0.25, 0.35))
  )

exploration hook (workDirectory / "summary")
